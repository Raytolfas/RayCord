# ========================
#  RayCord — .gitignore
# ========================

# --- Gradle build output ---
build/
/build/
**/build/
out/
/out/
.gradle/
.gradletasknamecache
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar

# --- Kotlin Gradle plugin cache ---
.kotlin/
build-logic/.kotlin/

# --- Velocity runtime files (generated on first run) ---
velocity.toml
raycord.toml
veloray.toml
forwarding.secret
server-icon.png
run/
plugins/
logs/
lang/
config/

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
.idea_modules/
out/
atlassian-ide-plugin.xml

# --- VS Code ---
.vscode/

# --- Fleet ---
.fleet/

# --- Eclipse ---
.metadata
.settings/
.classpath
.project
.loadpath
.recommenders/
.factorypath
.apt_generated/
.externalToolBuilders/
*.launch

# --- NetBeans ---
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# --- Windows ---
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
.apdisk

# --- Linux ---
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# --- Misc ---
*.tmp
*.bak
*.swp
*.class
*.jar
*.war
*.ear

# --- Native dependencies (cloned externally) ---
native/mbedtls/
native/zlib-ng/
native/zlib-cf/
native/libdeflate/
native/src/main/resources/linux_x86_64/velocity-cipher.so

# --- Antigravity agent folder ---
.agents/

